PORT=8080
DATABASE_URL=postgres://postgres:postgres@localhost:5432/recruitment_db?sslmode=disable&search_path=interview,public
DB_SCHEMA=interview
DB_MAX_CONNS=10
DB_MIN_CONNS=2

JWT_PUBLIC_KEY_PEM=
JWT_JWKS_URI=http://auth-service:8080/.well-known/jwks.json
JWT_ISSUER=auth-service
JWT_AUDIENCE=recruitment-platform

COMPANY_SERVICE_URL=http://company-service:8080
COMPANY_VERIFY_PATH=/companies/internal/recruiter-context
APPLICATION_SERVICE_URL=http://application-service:8080
APPLICATION_CONTEXT_PATH=/applications/internal/%s/scheduling-context

KAFKA_BROKERS=kafka:9092
KAFKA_INTERVIEW_TOPIC=interview-events

LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=devsecret123456789012345678901234
LIVEKIT_TOKEN_TTL=4h

INTERVIEW_CURSOR_SECRET=dev-only-interview-cursor-secret-32-bytes
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
